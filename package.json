{
  "name": "countuptimer",
  "version": "1.0.0",
  "description": "Website that is counting up from the date/time specified in the code",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run --globals --environment jsdom",
    "test:coverage": "vitest run --globals --environment jsdom --coverage --coverage.provider=istanbul --coverage.include=src/script.js --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
}
